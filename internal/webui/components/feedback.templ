// components/feedback.templ — widget feedback FAB + modal + formulaire partial.
// Migré depuis pkg/horui/components (vague 3) : utilise templux.Button au lieu de horui/ui.
package components

import (
	"net/url"

	"github.com/hazyhaar/assokit/internal/webui/templux"
	"github.com/hazyhaar/assokit/pkg/horui/middleware"
)

// FeedbackWidget rend le bouton FAB + modal vide. Injecté dans webui.Shell.
templ FeedbackWidget(pageURL, pageTitle string) {
	<div id="feedback-fab-container">
		<button
			class="fixed bottom-space-lg right-space-lg z-50 bg-accent text-ink-on-accent rounded-pill px-space-lg py-space-sm shadow-lg text-sm font-medium"
			hx-get={ "/feedback/form?url=" + url.QueryEscape(pageURL) + "&title=" + url.QueryEscape(pageTitle) }
			hx-target="#feedback-modal"
			hx-swap="innerHTML"
			data-feedback-fab
			aria-label="Feedback"
			type="button"
		>Feedback</button>
		<div id="feedback-modal" class="fixed bottom-space-lg right-space-lg z-50 w-80 bg-surface border border-border rounded-md shadow-lg p-space-md" hidden role="dialog" aria-modal="true" aria-label="Formulaire de feedback"></div>
	</div>
}

// FeedbackForm rend le formulaire partial (réponse au GET /feedback/form).
templ FeedbackForm(pageURL, pageTitle, csrfToken string) {
	<form
		action="/feedback"
		method="post"
		hx-post="/feedback"
		hx-target="#feedback-modal"
		hx-swap="innerHTML"
		class="flex flex-col gap-space-sm"
	>
		<input type="hidden" name="_csrf" value={ csrfToken }/>
		<input type="hidden" name="page_url" value={ pageURL }/>
		<input type="hidden" name="page_title" value={ pageTitle }/>
		<input
			type="text"
			name="website"
			tabindex="-1"
			autocomplete="off"
			style="display:none"
			aria-hidden="true"
		/>
		<div class="flex flex-col gap-space-xs">
			<label for="feedback-message" class="text-sm font-medium text-ink">Dites-nous ce que vous pensez de cette page</label>
			<textarea
				id="feedback-message"
				name="message"
				required
				minlength="5"
				maxlength="2000"
				placeholder="Dites-nous ce que vous pensez de cette page"
				rows="4"
				class="w-full rounded-md border border-border bg-surface text-ink px-space-md py-space-sm text-sm focus:outline-none focus:ring-2 focus:ring-accent"
			></textarea>
			<span id="fb-count" class="text-xs text-ink-faint" aria-live="polite">0 / 2000</span>
		</div>
		<div class="flex items-center gap-space-sm">
			@templux.Button("Envoyer", "primary", templ.Attributes{"type": "submit"})
			@templux.Button("Annuler", "secondary", templ.Attributes{"data-feedback-cancel": ""})
		</div>
	</form>
}

// FeedbackSuccess rend la confirmation (réponse POST réussie). Se ferme après 3s.
templ FeedbackSuccess() {
	<div role="status" class="feedback-success rounded-md border border-success bg-surface text-success px-space-md py-space-sm text-sm">
		Merci, votre avis a été enregistré.
	</div>
	<style>.feedback-success{animation:fbFadeOut .5s 3s forwards}@keyframes fbFadeOut{to{opacity:0}}</style>
	<script nonce={ middleware.NonceFromContext(ctx) }>setTimeout(function(){var m=document.getElementById("feedback-modal");if(m){m.setAttribute("hidden","");m.innerHTML="";}},3500);</script>
}
