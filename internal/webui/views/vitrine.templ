// views/vitrine.templ — page vitrine (home) migree vers templux vague 1.
// Remplace pages.Home() de pkg/horui/pages pour les handlers cables sur webui.Shell.
package views

import (
	"github.com/hazyhaar/assokit/internal/webui/templux"
	"github.com/hazyhaar/assokit/pkg/horui/theme"
)

// Home est la landing page generique de l'instance.
// Le handler la fournit comme content a webui.Shell.
templ Home() {
	<section class="hero py-space-2xl">
		<div class="max-w-3xl mx-auto text-center flex flex-col gap-space-md">
			<div class="text-sm font-medium text-accent">{ theme.Brand().Name }</div>
			<h1 class="text-3xl font-semibold text-ink">{ homeHeroTitle() }</h1>
			<p class="text-lg text-ink-muted">
				{ theme.Brand().Name } est un espace en ligne pour sa communauté :
				adhésion, échanges, dossiers partagés et information — au même
				endroit, ouvert à ses membres.
			</p>
			<div class="flex flex-col sm:flex gap-space-sm items-center justify-center">
				@templux.LinkButton("Se connecter", "/login", "primary", templ.Attributes{})
				@templux.LinkButton(theme.T("nav.forum", "Voir le forum"), "/forum", "ghost", templ.Attributes{})
			</div>
		</div>
	</section>
	<section class="py-space-xl">
		<div class="grid grid-cols-1 sm:flex gap-space-lg max-w-3xl mx-auto">
			<div class="bg-surface-raised rounded-lg shadow-sm p-space-lg flex flex-col gap-space-sm">
				<h3 class="text-lg font-semibold text-ink">Adhérer</h3>
				<p class="text-ink-muted">Créer un compte, rejoindre la communauté et suivre la vie de l'organisation.</p>
			</div>
			<div class="bg-surface-raised rounded-lg shadow-sm p-space-lg flex flex-col gap-space-sm">
				<h3 class="text-lg font-semibold text-ink">Échanger</h3>
				<p class="text-ink-muted">Un forum de discussion par fils, des dossiers partagés et une recherche intégrée.</p>
			</div>
			<div class="bg-surface-raised rounded-lg shadow-sm p-space-lg flex flex-col gap-space-sm">
				<h3 class="text-lg font-semibold text-ink">Participer</h3>
				<p class="text-ink-muted">Événements, actualités et décisions collectives accessibles à tous les membres.</p>
			</div>
		</div>
	</section>
}

// homeHeroTitle retourne le titre du hero : la tagline de l'instance si elle
// est renseignee, sinon un repli generique non vide (pour que le h1 reste
// visible meme sans branding.tagline).
func homeHeroTitle() string {
	if t := theme.Brand().Tagline; t != "" {
		return t
	}
	return "Bienvenue dans l'espace communautaire de " + theme.Brand().Name
}
