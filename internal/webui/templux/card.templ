// templux card — surface élevée avec titre et slot body.
//
// Usage :
//   @Card("Résumé", summaryBody)

package templux


templ Card(title string, body templ.Component) {
	<div class="bg-surface-raised rounded-lg shadow-md p-space-xl">
		if title != "" {
			<h3 class="text-base font-semibold text-ink mb-space-md">{ title }</h3>
		}
		<div class="text-sm text-ink">
			@body
		</div>
	</div>
}
