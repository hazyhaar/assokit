// templux page-header — en-tête de page avec sous-titre, titre principal et slot d'actions.
//
// Usage :
//   @PageHeader("Communauté", "Forum", actionsComponent)
//   @PageHeader("", "Mon compte", nil)
package templux

templ PageHeader(subtitle string, title string, actions templ.Component) {
	<div class="flex items-center justify-between gap-space-md px-space-xs">
		<div class="flex flex-col">
			if subtitle != "" {
				<div class="text-sm font-medium text-accent">{ subtitle }</div>
			}
			<h1 class="text-2xl font-semibold text-ink">{ title }</h1>
		</div>
		if actions != nil {
			@actions
		}
	</div>
}
