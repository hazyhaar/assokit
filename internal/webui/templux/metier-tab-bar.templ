// templux metier-tab-bar — barre d'onglets transverse de l'espace membre multi-profil.
// N'affiche que les onglets transmis (filtrage grade côté handler). Chaque item est
// un composant nommé ; aucune classe maison, utilitaires existants uniquement.

package templux

// MetierTabView décrit un onglet métier prêt au rendu (grade déjà filtré en amont).
type MetierTabView struct {
	Label  string
	Route  string
	Active bool
}

templ MetierTabBar(tabs []MetierTabView) {
	if len(tabs) > 0 {
		<nav aria-label="Profils métier" class="flex flex-wrap gap-space-sm border-b border-border pb-space-sm">
			for _, tab := range tabs {
				@MetierTabItem(tab)
			}
		</nav>
	}
}

templ MetierTabItem(tab MetierTabView) {
	<a
		href={ templ.SafeURL(tab.Route) }
		class={ metierTabItemClass(tab.Active) }
		aria-current={ metierTabAriaCurrent(tab.Active) }
	>
		{ tab.Label }
	</a>
}

func metierTabItemClass(active bool) string {
	base := "inline-flex items-center px-space-md py-space-sm rounded-md text-sm font-medium transition-colors"
	if active {
		return base + " bg-surface-raised border border-accent text-ink"
	}
	return base + " bg-transparent text-ink-muted hover:bg-surface-muted hover:text-ink"
}

func metierTabAriaCurrent(active bool) string {
	if active {
		return "page"
	}
	return ""
}